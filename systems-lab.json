    "postgres": {
      "kind": "postgres",
      "enabled": true,
      "evidence": [
        {
          "file": "docker-compose.yml",
          "line": 21,
          "reason": "PostgreSQL image declared by project"
        }
      ]
    },
    "redis": {
      "kind": "redis",
      "enabled": true,
      "evidence": [
        {
          "file": "docker-compose.yml",
          "line": 7,
          "reason": "Redis image declared by project"
        }
      ]
    },
    "nginx": {
      "kind": "nginx",
      "enabled": true,
      "origin": "lab-adapter",
      "evidence": [
        {
          "file": "systems-lab.json",
          "reason": "Explicit optional lab gateway, retained from the existing test setup; not detected in application source"
