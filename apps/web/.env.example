NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
# Optional read-only demo; no API or database is used when true. Rebuild after changing.
# NEXT_PUBLIC_PRESENTATION_MODE=true
# Production: set NEXT_PUBLIC_API_URL to the public system origin and API_PROXY_URL
# to the API origin (no /api suffix). Both are required during the Docker build.
# API_PROXY_URL=https://your-api.onrender.com
