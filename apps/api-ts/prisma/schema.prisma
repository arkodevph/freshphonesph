generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  COO
  GENERAL_MANAGER
  HR_PAYROLL
  FINANCE_OFFICER
  RECORDS
  ANALYTICS
  CS_HEAD
  CS_TEAM
  CORE_HANDLER
  CUSTOMER
}
enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}
enum ReleaseStatus {
  NOT_READY
  PROCESSING
  READY
  RELEASED
}
enum Cadence {
  WEEKLY
  SEMIMONTHLY
  MONTHLY
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CLARIFICATION
}
enum RequirementStatus {
  MISSING
  SUBMITTED
  APPROVED
  NEEDS_CLARIFICATION
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  DONE
}
enum KpiDecision {
  PENDING
  NOTED
  ACTION_RECOMMENDED
}
enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
}
enum ApplicantStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String
  role Role
  active Boolean @default(true)
  version Int @default(1)
  clientId String? @unique @db.Uuid
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions Session[]
  resets PasswordReset[]
  audit AuditEntry[]
  recordedPayments Payment[] @relation("PaymentRecorder")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  uploadedFiles StoredFile[]
  requirementReviews RequirementReview[] @relation("RequirementReviewer")
  notifications Notification[] @relation("NotificationRecipient")
  createdTasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  kpiReviews KpiReview[]
  assignedSupportCases SupportCase[] @relation("SupportAssignee")
  reviewedApplicants Applicant[] @relation("ApplicantReviewer")
  reportSnapshots ReportSnapshot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model Batch {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(30)
  model String @db.VarChar(100)
  status BatchStatus @default(PLANNED)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  contractPrice Decimal? @db.Decimal(12, 2)
  installmentCount Int?
  cadence Cadence?
  version Int @default(1)
  clients Client[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model Client {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  phone String @db.VarChar(25)
  joinedAt DateTime? @db.Date
  unitModel String @default("") @db.VarChar(100)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  status ClientStatus @default(ACTIVE)
  releaseStatus ReleaseStatus @default(NOT_READY)
  version Int @default(1)
  account User?
  schedule ScheduleItem[]
  payments Payment[]
  requirements ClientRequirement[]
  documents CustomerDocument[]
  supportCases SupportCase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([batchId])
  @@index([status, createdAt])
}
model ScheduleItem {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sequenceNo Int
  dueDate DateTime @db.Date
  expectedAmount Decimal @db.Decimal(12, 2)
  payments Payment[]
  @@unique([clientId, sequenceNo])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  scheduleItemId String? @db.Uuid
  scheduleItem ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  amount Decimal @db.Decimal(12, 2)
  paymentDate DateTime @db.Date
  method String @db.VarChar(40)
  referenceNumber String? @db.VarChar(120)
  notes String?
  verificationNotes String?
  proofFileId String? @unique @db.Uuid
  proofFile StoredFile? @relation(fields: [proofFileId], references: [id], onDelete: SetNull)
  status PaymentStatus @default(PENDING)
  recordedById String @db.Uuid
  recordedBy User @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verifierId String? @db.Uuid
  verifier User? @relation("PaymentVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  verifiedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, status])
  @@index([batchId, status])
  @@index([status, createdAt])
  @@index([paymentDate])
}
model StoredFile {
  id String @id @default(uuid()) @db.Uuid
  storageKey String @unique @db.VarChar(120)
  originalName String @db.VarChar(255)
  mimeType String @db.VarChar(80)
  size Int
  uploadedById String? @db.Uuid
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  payment Payment?
  customerDocument CustomerDocument?
  taskAttachment TaskAttachment?
  applicantAttachment ApplicantAttachment?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model RequirementType {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  label String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  allowedMimeTypes String[]
  maxBytes Int @default(5242880)
  customerCanUpload Boolean @default(true)
  active Boolean @default(true)
  version Int @default(1)
  requirements ClientRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, label])
}
model ClientRequirement {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  typeId String @db.Uuid
  type RequirementType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status RequirementStatus @default(MISSING)
  customerNote String @default("")
  internalNote String @default("")
  version Int @default(1)
  documents CustomerDocument[]
  reviews RequirementReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clientId, typeId])
  @@index([clientId, status])
  @@index([status, updatedAt])
}
model CustomerDocument {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirementId String @db.Uuid
  requirement ClientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  revision Int
  createdAt DateTime @default(now())
  @@unique([requirementId, revision])
  @@index([clientId, createdAt])
}
model RequirementReview {
  id String @id @default(uuid()) @db.Uuid
  requirementId String @db.Uuid
  requirement ClientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewerId String @db.Uuid
  reviewer User @relation("RequirementReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  fromStatus RequirementStatus
  toStatus RequirementStatus
  customerNote String
  internalNote String @default("")
  createdAt DateTime @default(now())
  @@index([requirementId, createdAt])
}
model Task {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(200)
  instructions String @default("")
  assigneeId String @db.Uuid
  assignee User @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creatorId String @db.Uuid
  creator User @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  priority TaskPriority @default(MEDIUM)
  deadline DateTime
  status TaskStatus @default(TODO)
  submissionTimestamp DateTime?
  lateFlag Boolean?
  version Int @default(1)
  attachments TaskAttachment[]
  reviews KpiReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assigneeId, status])
  @@index([status, deadline])
}
model TaskAttachment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}
model KpiReview {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId String @db.Uuid
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  factualEvidence String
  evaluation String @default("")
  recommendation String @default("") @db.VarChar(200)
  decision KpiDecision @default(PENDING)
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}
model SupportCase {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category String @db.VarChar(80)
  description String
  assignedStaffId String? @db.Uuid
  assignedStaff User? @relation("SupportAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  status SupportStatus @default(OPEN)
  resolution String @default("")
  closedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([clientId, status])
}
model JobOpening {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(160)
  description String @default("")
  location String @default("") @db.VarChar(120)
  employmentType String @default("") @db.VarChar(60)
  isOpen Boolean @default(true)
  version Int @default(1)
  applicants Applicant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isOpen, createdAt])
}
model Applicant {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  job JobOpening @relation(fields: [jobId], references: [id], onDelete: Restrict)
  fullName String @db.VarChar(200)
  email String @db.VarChar(254)
  phone String @default("") @db.VarChar(40)
  message String @default("")
  status ApplicantStatus @default(RECEIVED)
  reviewerNotes String @default("")
  reviewerId String? @db.Uuid
  reviewer User? @relation("ApplicantReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  version Int @default(1)
  attachments ApplicantAttachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([jobId, createdAt])
}
model ApplicantAttachment {
  id String @id @default(uuid()) @db.Uuid
  applicantId String @db.Uuid
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([applicantId, createdAt])
}
model Agent {
  id String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(200)
  agentCode String @unique @db.VarChar(60)
  phone String @default("") @db.VarChar(40)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([fullName])
}
model NotificationTemplate {
  id String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(80)
  title String @db.VarChar(160)
  body String
  emailEnabled Boolean @default(true)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  eventKey String @db.VarChar(80)
  title String @db.VarChar(160)
  body String
  link String? @db.VarChar(300)
  dedupeKey String @unique @db.VarChar(180)
  readAt DateTime?
  deliveries NotificationDelivery[]
  createdAt DateTime @default(now())
  @@index([recipientId, readAt, createdAt])
}
model NotificationDelivery {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status DeliveryStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([notificationId])
  @@index([status, nextAttemptAt])
}
model ReportSnapshot {
  id String @id @default(uuid()) @db.Uuid
  kind String @db.VarChar(30)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  payload Json
  createdById String @db.Uuid
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([kind, periodStart, periodEnd])
  @@index([createdAt])
}
model AuditEntry {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  entity String
  recordId String @db.Uuid
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model ChangeEvent {
  id BigInt @id @default(autoincrement())
  entity String
  recordId String @db.Uuid
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  count Int @default(1)
  resetsAt DateTime
}
