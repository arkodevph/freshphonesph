generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  COO
  GENERAL_MANAGER
  HR_PAYROLL
  FINANCE_OFFICER
  RECORDS
  ANALYTICS
  CS_HEAD
  CS_TEAM
  CORE_HANDLER
  CUSTOMER
}
enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}
enum ReleaseStatus {
  NOT_READY
  PROCESSING
  READY
  RELEASED
}
enum Cadence {
  WEEKLY
  SEMIMONTHLY
  MONTHLY
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CLARIFICATION
}
enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
}
enum DocumentStatus {
  SUBMITTED
  APPROVED
  NEEDS_CLARIFICATION
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  DONE
}
enum TaskAlertKind {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
}
enum KpiDecision {
  PENDING
  NOTED
  ACTION_RECOMMENDED
}
enum StaffEmailKind {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  FINANCE_PENDING
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYMENT_CLARIFICATION
  SUPPORT_NEW_CASE
  SUPPORT_ASSIGNED
  SUPPORT_CUSTOMER_REPLY
  ACCOUNT_CREATED
  ACCOUNT_ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
}
enum AccountAlertKind {
  ACCOUNT_CREATED
  ACCOUNT_ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
}
enum SupportAlertKind {
  SUPPORT_NEW_CASE
  SUPPORT_ASSIGNED
  SUPPORT_CUSTOMER_REPLY
}
enum StaffEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}
model User {
  requirementReviews RequirementReview[] @relation("RequirementReviewer")
  staffNotifications StaffNotification[] @relation("NotificationRecipient")
  reviewedApplicants Applicant[] @relation("ApplicantReviewer")
  reportSnapshots ReportSnapshot[]
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String
  role Role
  active Boolean @default(true)
  version Int @default(1)
  clientId String? @unique @db.Uuid
  hrConfidentialAccess Boolean @default(false)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions Session[]
  resets PasswordReset[]
  audit AuditEntry[]
  recordedPayments Payment[] @relation("PaymentRecorder")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  paymentAdjustments PaymentAdjustment[]
  uploadedFiles StoredFile[]
  assignedCases SupportCase[] @relation("CaseAssignee")
  supportMessages SupportMessage[]
  releaseUpdates ReleaseUpdate[]
  notifications Notification[]
  financeAlertReads FinanceAlertRead[]
  taskAlertReads TaskAlertRead[]
  paymentResultAlerts PaymentResultAlert[]
  staffEmails StaffEmail[]
  supportAlerts SupportAlert[]
  accountAlerts AccountAlert[] @relation("AccountAlertRecipient")
  accessAlerts AccountAlert[] @relation("AccountAlertSubject")
  reviewedDocuments CustomerDocument[] @relation("DocumentReviewer")
  assignedTasks Task[] @relation("TaskAssignee")
  handledBatches Batch[] @relation("BatchHandler")
  createdTasks Task[] @relation("TaskCreator")
  kpiReviews KpiReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model Batch {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(30)
  model String @db.VarChar(100)
  status BatchStatus @default(PLANNED)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  contractPrice Decimal? @db.Decimal(12, 2)
  installmentCount Int?
  cadence Cadence?
  version Int @default(1)
  handlerId String? @db.Uuid
  handler User? @relation("BatchHandler", fields: [handlerId], references: [id], onDelete: Restrict)
  agentId String? @db.Uuid
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Restrict)
  clients Client[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([handlerId, createdAt, id])
  @@index([agentId, createdAt, id])
}
model Agent {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(200)
  code String @unique @db.VarChar(60)
  active Boolean @default(true)
  version Int @default(1)
  batches Batch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, name, id])
}
model Client {
  requirements ClientRequirement[]
  requirementDocuments RequirementDocument[]
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  phone String @db.VarChar(25)
  joinedAt DateTime? @db.Date
  unitModel String @default("") @db.VarChar(100)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  status ClientStatus @default(ACTIVE)
  releaseStatus ReleaseStatus @default(NOT_READY)
  version Int @default(1)
  account User?
  schedule ScheduleItem[]
  payments Payment[]
  supportCases SupportCase[]
  releaseUpdates ReleaseUpdate[]
  documents CustomerDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([batchId])
  @@index([status, createdAt])
}
model CustomerDocument {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  requirementKey String @db.VarChar(60)
  fileId String @unique @db.Uuid
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  status DocumentStatus @default(SUBMITTED)
  clarification String @default("")
  reviewedById String? @db.Uuid
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([clientId, requirementKey, createdAt])
  @@index([status, createdAt, id])
}
model SupportCase {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category String @db.VarChar(80)
  description String
  status SupportStatus @default(OPEN)
  resolution String @default("")
  assignedStaffId String? @db.Uuid
  assignedStaff User? @relation("CaseAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  alerts SupportAlert[]
  closedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt, id])
}
model AccountAlert {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation("AccountAlertRecipient", fields: [userId], references: [id], onDelete: Cascade)
  accountId String @db.Uuid
  account User @relation("AccountAlertSubject", fields: [accountId], references: [id], onDelete: Cascade)
  accountVersion Int
  kind AccountAlertKind
  accountName String @db.VarChar(100)
  actorName String @db.VarChar(100)
  previousRole Role?
  role Role
  previousActive Boolean?
  active Boolean
  readAt DateTime?
  createdAt DateTime @default(now())
  staffEmails StaffEmail[]
  @@unique([userId, accountId, accountVersion, kind])
  @@index([userId, createdAt, id])
  @@index([accountId])
}
model SupportAlert {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId String @db.Uuid
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseVersion Int
  kind SupportAlertKind
  readAt DateTime?
  handledAt DateTime?
  createdAt DateTime @default(now())
  staffEmails StaffEmail[]
  @@unique([userId, caseId, caseVersion, kind])
  @@index([userId, createdAt, id])
  @@index([caseId, kind, handledAt])
}
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId String @db.Uuid
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body String @db.VarChar(5000)
  createdAt DateTime @default(now())
  @@index([caseId, createdAt, id])
}
model ReleaseUpdate {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  status ReleaseStatus
  note String @default("") @db.VarChar(1000)
  collectionDate DateTime? @db.Date
  createdAt DateTime @default(now())
  @@index([clientId, createdAt, id])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(50)
  title String @db.VarChar(120)
  message String @db.VarChar(500)
  targetPath String? @db.VarChar(300)
  readAt DateTime?
  emailStatus String @default("PENDING") @db.VarChar(20)
  emailAttempts Int @default(0)
  emailNextAt DateTime @default(now())
  emailSentAt DateTime?
  emailError String? @db.VarChar(250)
  dedupeKey String? @unique @db.VarChar(180)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([emailStatus, emailNextAt])
}
model CustomerEmailTemplate {
  kind String @id @db.VarChar(50)
  subject String @db.VarChar(180)
  body String
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model CustomerNotificationConfig {
  key String @id @db.VarChar(40)
  reminderDays String @default("") @db.VarChar(100)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model ScheduleItem {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sequenceNo Int
  dueDate DateTime @db.Date
  expectedAmount Decimal @db.Decimal(12, 2)
  payments Payment[]
  @@unique([clientId, sequenceNo])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  scheduleItemId String? @db.Uuid
  scheduleItem ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  amount Decimal @db.Decimal(12, 2)
  paymentDate DateTime @db.Date
  method String @db.VarChar(40)
  referenceNumber String? @db.VarChar(120)
  receiptTime String? @db.VarChar(20)
  receiptName String? @db.VarChar(120)
  receiptPhone String? @db.VarChar(40)
  notes String?
  verificationNotes String?
  proofFileId String? @unique @db.Uuid
  proofFile StoredFile? @relation(fields: [proofFileId], references: [id], onDelete: SetNull)
  alertReads FinanceAlertRead[]
  resultAlerts PaymentResultAlert[]
  staffEmails StaffEmail[]
  adjustments PaymentAdjustment[]
  status PaymentStatus @default(PENDING)
  recordedById String @db.Uuid
  recordedBy User @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verifierId String? @db.Uuid
  verifier User? @relation("PaymentVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  verifiedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, status])
  @@index([batchId, status])
  @@index([status, createdAt])
  @@index([status, updatedAt, id])
  @@index([paymentDate])
}
model PaymentAdjustment {
  id String @id @default(uuid()) @db.Uuid
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  requestId String @unique @db.Uuid
  sequence Int
  paymentVersion Int
  amount Decimal @db.Decimal(12, 2)
  beforeAmount Decimal @db.Decimal(12, 2)
  afterAmount Decimal @db.Decimal(12, 2)
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@unique([paymentId, sequence])
  @@index([createdAt, id])
}
model FinanceAlertRead {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  seenVersion Int
  readAt DateTime @default(now())
  @@id([userId, paymentId])
  @@index([paymentId])
}
model PaymentResultAlert {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String @db.Uuid
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentVersion Int
  decision PaymentStatus
  amount Decimal @db.Decimal(12, 2)
  clientName String @db.VarChar(200)
  batchCode String @db.VarChar(30)
  notes String @db.VarChar(1000)
  verifierName String @db.VarChar(100)
  readAt DateTime?
  createdAt DateTime @default(now())
  staffEmails StaffEmail[]
  @@unique([userId, paymentId, paymentVersion])
  @@index([userId, createdAt, id])
  @@index([paymentId])
}
model StoredFile {
  requirementDocument RequirementDocument?
  workAttachment TaskAttachment?
  applicantAttachment ApplicantAttachment?
  id String @id @default(uuid()) @db.Uuid
  storageKey String @unique @db.VarChar(120)
  originalName String @db.VarChar(255)
  mimeType String @db.VarChar(80)
  size Int
  uploadedById String? @db.Uuid
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  payment Payment?
  document CustomerDocument?
  taskAttachment Task?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Task {
  attachments TaskAttachment[]
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(200)
  instructions String @default("")
  assigneeId String @db.Uuid
  assignee User @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creatorId String @db.Uuid
  creator User @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  priority TaskPriority @default(MEDIUM)
  deadline DateTime
  status TaskStatus @default(TODO)
  report String @default("")
  submittedAt DateTime?
  lateFlag Boolean?
  attachmentFileId String? @unique @db.Uuid
  attachment StoredFile? @relation(fields: [attachmentFileId], references: [id], onDelete: Restrict)
  review KpiReview?
  alertReads TaskAlertRead[]
  staffEmails StaffEmail[]
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assigneeId, status])
  @@index([status, deadline])
}
model TaskAlertRead {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind TaskAlertKind
  deadline DateTime
  readAt DateTime @default(now())
  @@id([userId, taskId, kind])
  @@index([taskId])
}
model StaffEmailTemplate {
  kind StaffEmailKind @id
  enabled Boolean @default(true)
  subject String @db.VarChar(180)
  body String
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model StaffNotificationConfig {
  key String @id @db.VarChar(40)
  dueSoonHours Int @default(24)
  overdueHours Int @default(0)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model StaffEmail {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind StaffEmailKind
  taskId String? @db.Uuid
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deadline DateTime?
  paymentId String? @db.Uuid
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentVersion Int?
  resultId String? @db.Uuid
  result PaymentResultAlert? @relation(fields: [resultId], references: [id], onDelete: Cascade)
  supportAlertId String? @db.Uuid
  supportAlert SupportAlert? @relation(fields: [supportAlertId], references: [id], onDelete: Cascade)
  accountAlertId String? @db.Uuid
  accountAlert AccountAlert? @relation(fields: [accountAlertId], references: [id], onDelete: Cascade)
  dedupeKey String @unique @db.VarChar(240)
  recipientEmail String @db.VarChar(254)
  title String @db.VarChar(120)
  message String @db.VarChar(1000)
  targetPath String @db.VarChar(300)
  subjectTemplate String @db.VarChar(180)
  bodyTemplate String
  renderedSubject String?
  renderedBody String?
  sender String? @db.VarChar(254)
  status StaffEmailStatus @default(PENDING)
  attempts Int @default(0)
  totalAttempts Int @default(0)
  nextAt DateTime @default(now())
  sentAt DateTime?
  error String? @db.VarChar(250)
  attemptId String? @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([status, nextAt])
  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@index([taskId])
  @@index([paymentId])
  @@index([resultId])
  @@index([supportAlertId])
  @@index([accountAlertId])
}
model KpiReview {
  id String @id @default(uuid()) @db.Uuid
  taskId String @unique @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reviewerId String @db.Uuid
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  factualEvidence String
  evaluation String
  recommendation String @db.VarChar(200)
  decision KpiDecision
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model AuditEntry {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  entity String
  recordId String @db.Uuid
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([entity, recordId, action])
}
model ChangeEvent {
  id BigInt @id @default(autoincrement())
  entity String
  recordId String @db.Uuid
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  count Int @default(1)
  resetsAt DateTime
}

enum RequirementStatus {
  MISSING
  SUBMITTED
  APPROVED
  NEEDS_CLARIFICATION
}
enum ApplicantStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}
model RequirementType {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  label String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  allowedMimeTypes String[]
  maxBytes Int @default(5242880)
  customerCanUpload Boolean @default(true)
  active Boolean @default(true)
  version Int @default(1)
  requirements ClientRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, label])
}
model ClientRequirement {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  typeId String @db.Uuid
  type RequirementType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status RequirementStatus @default(MISSING)
  customerNote String @default("")
  internalNote String @default("")
  version Int @default(1)
  documents RequirementDocument[]
  reviews RequirementReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([clientId, typeId])
  @@index([clientId, status])
  @@index([status, updatedAt])
}
model RequirementDocument {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirementId String @db.Uuid
  requirement ClientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  revision Int
  createdAt DateTime @default(now())
  @@unique([requirementId, revision])
  @@index([clientId, createdAt])
}
model RequirementReview {
  id String @id @default(uuid()) @db.Uuid
  requirementId String @db.Uuid
  requirement ClientRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewerId String @db.Uuid
  reviewer User @relation("RequirementReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  fromStatus RequirementStatus
  toStatus RequirementStatus
  customerNote String
  internalNote String @default("")
  createdAt DateTime @default(now())
  @@index([requirementId, createdAt])
}
model TaskAttachment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}
model JobOpening {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(160)
  description String @default("")
  location String @default("") @db.VarChar(120)
  employmentType String @default("") @db.VarChar(60)
  isOpen Boolean @default(true)
  version Int @default(1)
  applicants Applicant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isOpen, createdAt])
}
model Applicant {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  job JobOpening @relation(fields: [jobId], references: [id], onDelete: Restrict)
  fullName String @db.VarChar(200)
  email String @db.VarChar(254)
  phone String @default("") @db.VarChar(40)
  message String @default("")
  status ApplicantStatus @default(RECEIVED)
  reviewerNotes String @default("")
  reviewerId String? @db.Uuid
  reviewer User? @relation("ApplicantReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  version Int @default(1)
  attachments ApplicantAttachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([jobId, createdAt])
}
model ApplicantAttachment {
  id String @id @default(uuid()) @db.Uuid
  applicantId String @db.Uuid
  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  storedFileId String @unique @db.Uuid
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([applicantId, createdAt])
}
model NotificationTemplate {
