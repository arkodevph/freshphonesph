generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  COO
  GENERAL_MANAGER
  HR_PAYROLL
  FINANCE_OFFICER
  RECORDS
  ANALYTICS
  CS_HEAD
  CS_TEAM
  CORE_HANDLER
  CUSTOMER
}
enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}
enum ReleaseStatus {
  NOT_READY
  PROCESSING
  READY
  RELEASED
}
enum Cadence {
  WEEKLY
  SEMIMONTHLY
  MONTHLY
}
enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CLARIFICATION
}
enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
}
enum DocumentStatus {
  SUBMITTED
  APPROVED
  NEEDS_CLARIFICATION
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String
  role Role
  active Boolean @default(true)
  version Int @default(1)
  clientId String? @unique @db.Uuid
  client Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessions Session[]
  resets PasswordReset[]
  audit AuditEntry[]
  recordedPayments Payment[] @relation("PaymentRecorder")
  verifiedPayments Payment[] @relation("PaymentVerifier")
  uploadedFiles StoredFile[]
  assignedCases SupportCase[] @relation("CaseAssignee")
  supportMessages SupportMessage[]
  releaseUpdates ReleaseUpdate[]
  notifications Notification[]
  reviewedDocuments CustomerDocument[] @relation("DocumentReviewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
}
model Batch {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(30)
  model String @db.VarChar(100)
  status BatchStatus @default(PLANNED)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  contractPrice Decimal? @db.Decimal(12, 2)
  installmentCount Int?
  cadence Cadence?
  version Int @default(1)
  clients Client[]
  payments Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model Client {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  phone String @db.VarChar(25)
  joinedAt DateTime? @db.Date
  unitModel String @default("") @db.VarChar(100)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  status ClientStatus @default(ACTIVE)
  releaseStatus ReleaseStatus @default(NOT_READY)
  version Int @default(1)
  account User?
  schedule ScheduleItem[]
  payments Payment[]
  supportCases SupportCase[]
  releaseUpdates ReleaseUpdate[]
  documents CustomerDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([batchId])
  @@index([status, createdAt])
}
model CustomerDocument {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  requirementKey String @db.VarChar(60)
  fileId String @unique @db.Uuid
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  status DocumentStatus @default(SUBMITTED)
  clarification String @default("")
  reviewedById String? @db.Uuid
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([clientId, requirementKey, createdAt])
}
model SupportCase {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  category String @db.VarChar(80)
  description String
  status SupportStatus @default(OPEN)
  resolution String @default("")
  assignedStaffId String? @db.Uuid
  assignedStaff User? @relation("CaseAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages SupportMessage[]
  closedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, createdAt])
  @@index([status, createdAt])
}
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  caseId String @db.Uuid
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId String @db.Uuid
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body String @db.VarChar(5000)
  createdAt DateTime @default(now())
  @@index([caseId, createdAt, id])
}
model ReleaseUpdate {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  status ReleaseStatus
  note String @default("") @db.VarChar(1000)
  collectionDate DateTime? @db.Date
  createdAt DateTime @default(now())
  @@index([clientId, createdAt, id])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(50)
  title String @db.VarChar(120)
  message String @db.VarChar(500)
  targetPath String? @db.VarChar(300)
  readAt DateTime?
  emailStatus String @default("PENDING") @db.VarChar(20)
  emailAttempts Int @default(0)
  emailNextAt DateTime @default(now())
  emailSentAt DateTime?
  emailError String? @db.VarChar(250)
  dedupeKey String? @unique @db.VarChar(180)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([emailStatus, emailNextAt])
}
model CustomerEmailTemplate {
  kind String @id @db.VarChar(50)
  subject String @db.VarChar(180)
  body String
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model CustomerNotificationConfig {
  key String @id @db.VarChar(40)
  reminderDays String @default("") @db.VarChar(100)
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model ScheduleItem {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sequenceNo Int
  dueDate DateTime @db.Date
  expectedAmount Decimal @db.Decimal(12, 2)
  payments Payment[]
  @@unique([clientId, sequenceNo])
}
model Payment {
  id String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  batchId String @db.Uuid
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  scheduleItemId String? @db.Uuid
  scheduleItem ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  amount Decimal @db.Decimal(12, 2)
  paymentDate DateTime @db.Date
  method String @db.VarChar(40)
  referenceNumber String? @db.VarChar(120)
  notes String?
  verificationNotes String?
  proofFileId String? @unique @db.Uuid
  proofFile StoredFile? @relation(fields: [proofFileId], references: [id], onDelete: SetNull)
  status PaymentStatus @default(PENDING)
  recordedById String @db.Uuid
  recordedBy User @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  verifierId String? @db.Uuid
  verifier User? @relation("PaymentVerifier", fields: [verifierId], references: [id], onDelete: Restrict)
  verifiedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([clientId, status])
  @@index([batchId, status])
  @@index([status, createdAt])
  @@index([paymentDate])
}
model StoredFile {
  id String @id @default(uuid()) @db.Uuid
  storageKey String @unique @db.VarChar(120)
  originalName String @db.VarChar(255)
  mimeType String @db.VarChar(80)
  size Int
  uploadedById String @db.Uuid
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  payment Payment?
  document CustomerDocument?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model AuditEntry {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  entity String
  recordId String @db.Uuid
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model ChangeEvent {
  id BigInt @id @default(autoincrement())
  entity String
  recordId String @db.Uuid
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  count Int @default(1)
  resetsAt DateTime
}
