NODE_ENV=development
PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgresql://fresh:fresh@localhost:5435/fresh
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Automatic emails write to .local/mail in development. The Owner's "Send test email"
# button uses Resend in any environment and requires both values below.
# For a local test to your own Resend signup address, use EMAIL_FROM=Fresh Phones Test <onboarding@resend.dev>.
# A verified Fresh Phones PH sending domain is required to email customers in production.
RESEND_API_KEY=
EMAIL_FROM=Fresh Phones <accounts@example.com>
# Production requires an explicit sender on a verified Fresh Phones PH sending domain.
# Optional comma-separated customer installment reminder offsets, such as 3,0.
# Keep blank until Fresh Phones PH approves reminder timing and wording.
CUSTOMER_REMINDER_DAYS_BEFORE=
# Private file storage. Production requires a private S3-compatible bucket.
PRIVATE_STORAGE_PROVIDER=local
# PRIVATE_STORAGE_DIR=./.local/private
# PRIVATE_STORAGE_S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
# PRIVATE_STORAGE_S3_REGION=ap-southeast-1
# PRIVATE_STORAGE_S3_BUCKET=private-files
# PRIVATE_STORAGE_S3_ACCESS_KEY=
# PRIVATE_STORAGE_S3_SECRET_KEY=
