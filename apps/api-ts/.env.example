NODE_ENV=development
PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgresql://fresh:fresh@localhost:5435/fresh
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4100/api/auth
# Production requires staff MFA and a same-origin HTTPS /api gateway. Locally, demo roles stay accessible.
AUTH_REQUIRE_STAFF_MFA=false
# JWT_SECRET is a local migration fallback only; production requires BETTER_AUTH_SECRET.
# Automatic emails write to .local/mail in development. The Owner's "Send test email"
# button uses Resend in any environment and requires both values below.
# For a local test to your own Resend signup address, use EMAIL_FROM=Fresh Phones Test <onboarding@resend.dev>.
# A verified Fresh Phones PH sending domain is required to email customers in production.
RESEND_API_KEY=
EMAIL_FROM=Fresh Phones <accounts@example.com>
# Production requires an explicit sender on a verified Fresh Phones PH sending domain.
# Inspect email prerequisites with: pnpm --filter @fresh/api-ts staff-email:check
# Sender setup, isolated smoke test and Owner sign-off: docs/33-staff-email-launch.md
# Optional comma-separated customer installment reminder offsets, such as 3,0.
# Keep blank until Fresh Phones PH approves reminder timing and wording.
CUSTOMER_REMINDER_DAYS_BEFORE=
# Local Redis is authenticated, persistent, and exposed only on loopback.
REDIS_URL=redis://:fresh-local-redis@localhost:6380/0
REDIS_NAMESPACE=freshphones-local
# Leave unset for direct API access. Set only the exact IPs/CIDRs of reverse proxies
# that overwrite forwarded headers and cannot be bypassed by reaching the API directly.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Optional deployment-tuned quotas, JSON: policy -> [[maximum, windowSeconds], ...].
# Never disable protection. Defaults and all policy names: docs/54-abuse-rate-limits.md
# ABUSE_LIMITS={"agentLookup":[[30,60],[300,3600]],"application":[[5,3600],[20,86400]]}
# Optional simultaneous SSE caps (shared across replicas), defaults 8/account, 400/address group.
# ABUSE_STREAM_ACCOUNT_MAX=8
# ABUSE_STREAM_ADDRESS_MAX=400
# Run separately: pnpm --filter @fresh/api-ts worker:dev
# Production: private Redis network (rediss:// for remote TLS), generated password,
# unique namespace per deployment, AOF persistence, maxmemory-policy=noeviction.
# Private file storage. Production requires a private S3-compatible bucket.
PRIVATE_STORAGE_PROVIDER=local
# PRIVATE_STORAGE_DIR=./.local/private
# PRIVATE_STORAGE_S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
# PRIVATE_STORAGE_S3_REGION=ap-southeast-1
# PRIVATE_STORAGE_S3_BUCKET=private-files
# PRIVATE_STORAGE_S3_ACCESS_KEY=
# PRIVATE_STORAGE_S3_SECRET_KEY=
