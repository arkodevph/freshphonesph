# Copy to .env.production at the repository root. Keep the populated file private.
# All services use external production dependencies; this file provisions none.
WEB_ORIGIN=https://system.example.com
PUBLIC_SITE_ORIGIN=https://www.example.com
WEB_PORT=3000
NODE_ENV=production
HOST=0.0.0.0
PORT=4100
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_URL=https://system.example.com/api/auth
BETTER_AUTH_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
AUTH_REQUIRE_STAFF_MFA=true
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
REDIS_NAMESPACE=freshphones-production
RESEND_API_KEY=
EMAIL_FROM=Fresh Phones <accounts@example.com>
PRIVATE_STORAGE_PROVIDER=s3
PRIVATE_STORAGE_S3_ENDPOINT=https://STORAGE_HOST
PRIVATE_STORAGE_S3_REGION=ap-southeast-1
PRIVATE_STORAGE_S3_BUCKET=
PRIVATE_STORAGE_S3_ACCESS_KEY=
PRIVATE_STORAGE_S3_SECRET_KEY=
# Set only after validating the real gateway forwarding chain.
# TRUSTED_PROXY_CIDRS=
# Keep reminders disabled until approved.
CUSTOMER_REMINDER_DAYS_BEFORE=
