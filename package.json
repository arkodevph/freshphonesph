{
  "name": "fresh-phones-ph",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "web": "pnpm --filter @fresh/web",
    "api": "pnpm --filter @fresh/api-ts",
    "api:ts": "pnpm --filter @fresh/api-ts",
    "typecheck": "pnpm --filter @freshphones/contracts build && pnpm --filter @fresh/api-ts typecheck && pnpm --filter @fresh/web exec tsc --noEmit && pnpm --filter @fresh/landing exec tsc --noEmit",
    "test:api-ts": "pnpm --filter @fresh/api-ts test",
    "test:api-ts:integration": "pnpm --filter @fresh/api-ts test:integration",
    "db:generate": "pnpm --filter @fresh/api-ts db:generate",
    "db:migrate": "pnpm --filter @fresh/api-ts db:migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "format": "node scripts/format-code.mjs --write",
    "format:check": "node scripts/format-code.mjs",
    "landing": "pnpm --filter @fresh/landing",
    "production:config": "docker compose --env-file .env.production -f docker-compose.production.yml config --quiet",
    "production:build": "docker compose --env-file .env.production -f docker-compose.production.yml build",
    "production:start": "docker compose --env-file .env.production -f docker-compose.production.yml up -d --wait",
    "production:stop": "docker compose --env-file .env.production -f docker-compose.production.yml stop"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "better-call>zod": "4.6.5"
    }
  }
}
